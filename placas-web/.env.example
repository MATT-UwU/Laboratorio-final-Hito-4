APP_NAME="Peaje Inteligente"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tusubdominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=error

# Base de datos (MySQL en VPS Hostinger)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peaje_db
DB_USERNAME=peaje_user
DB_PASSWORD=tu_password_segura

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Google OAuth 2.0
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=https://tusubdominio.com/auth/google/callback

# URL base del notebook/API Python (RunPod o Colab); Laravel envía imágenes a POST /predict.
# No ejecutar ni alojar los modelos Python en el servidor Laravel.
INFERENCE_URL=https://tu-endpoint-runpod.runpod.io
INFERENCE_API_TOKEN=pon_aqui_el_mismo_secreto_configurado_en_colab

# Dispositivo de alerta ESP32 (bonificación hardware): token propio del dispositivo
DEVICE_TOKEN=

# Agente conversacional con LLM propio (Qwen en RunPod vía INFERENCE_URL/llm/chat). false = reglas
AGENTE_LLM=false
LLM_URL=
LLM_API_TOKEN=

# Servicio Colab independiente de keypoints humanos (week_2_servidor_pose_colab_v2.ipynb)
POSE_INFERENCE_URL=https://tu-tunel-colab.trycloudflare.com
POSE_INFERENCE_API_TOKEN=pon_aqui_el_API_TOKEN_generado_por_el_notebook

# Acceso demo (false en produccion: la rubrica exige solo Google)
DEMO_LOGIN=false
